# Browser client WebSocket endpoint.
# Local development defaults to ws://<browser-host>:8787 when omitted.
VITE_COMMONLINE_WS_URL=ws://localhost:8787

# Optional STUN server for WebRTC ICE discovery.
# Leave blank for same-host / simple local-network P0 testing.
# Cross-network use will eventually require a properly operated TURN service.
VITE_COMMONLINE_STUN_URL=

# Room service HTTP/WebSocket port.
PORT=8787
