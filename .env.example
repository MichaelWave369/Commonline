# Browser client WebSocket endpoint.
# localhost may use ws:// for development. Deployed Commonline must use wss://.
VITE_COMMONLINE_WS_URL=ws://localhost:8787

# Server-provided ICE discovery.
# Comma-separate multiple URLs.
COMMONLINE_STUN_URLS=

# TURN relay URLs. Comma-separate UDP/TCP/TLS variants as needed.
COMMONLINE_TURN_URLS=

# Preferred for coturn REST-style time-limited credentials.
# Keep this secret on the Commonline server only.
COMMONLINE_TURN_SHARED_SECRET=
COMMONLINE_TURN_CREDENTIAL_TTL_SECONDS=3600

# Demo/local fallback only. Long-lived static TURN credentials are not
# recommended for public deployments.
COMMONLINE_TURN_USERNAME=
COMMONLINE_TURN_CREDENTIAL=

# "all" allows direct/STUN paths and TURN fallback.
# "relay" forces TURN and is useful for relay verification.
COMMONLINE_ICE_TRANSPORT_POLICY=all

# Room service HTTP/WebSocket port.
PORT=8787

# Local durable Commonline room database.
COMMONLINE_DB_PATH=./data/commonline.db


# P0-j mediasoup SFU media listener.
# Local development can stay on loopback. For deployed containers/VMs, bind a
# reachable interface and set ANNOUNCED_ADDRESS to the public/NAT-reachable IP
# or hostname clients should use for ICE.
COMMONLINE_SFU_LISTEN_IP=127.0.0.1
COMMONLINE_SFU_ANNOUNCED_ADDRESS=
COMMONLINE_SFU_PORT=44444


# P0-n local agent voice renderer.
# disabled: authority exists but no agent audio source can be created.
# piper: invoke a local Piper CLI and model. No voice model is bundled.
# tone: deterministic non-speech CI/dev proof only.
COMMONLINE_TTS_ENGINE=disabled
COMMONLINE_PIPER_COMMAND=piper
COMMONLINE_PIPER_MODEL=
COMMONLINE_PIPER_SPEAKER=
COMMONLINE_PIPER_CUDA=false
COMMONLINE_PIPER_TIMEOUT_MS=30000


# P0-p bounded local speech recognition.
# disabled: push-to-share lease UI is present but no local STT is available.
# whispercpp: invoke a local whisper.cpp CLI and model. No model is bundled.
# deterministic: CI/dev proof only; it does not recognize speech content.
COMMONLINE_STT_ENGINE=disabled
COMMONLINE_WHISPER_COMMAND=whisper-cli
COMMONLINE_WHISPER_MODEL=
COMMONLINE_WHISPER_LANGUAGE=auto
COMMONLINE_WHISPER_TIMEOUT_MS=30000


# P0-aa secure two-device pilot host.
# Leave unset for ordinary localhost development.
# When true, Vite binds to 0.0.0.0 and requires the same PFX used by the server.
COMMONLINE_PILOT_LAN_HOST=false
COMMONLINE_TLS_PFX_FILE=
COMMONLINE_TLS_PFX_PASSPHRASE=

# P0-w/P0-y qualified local silent worker.
COMMONLINE_AGENT_MODE=mock
COMMONLINE_OLLAMA_MODEL=
COMMONLINE_OLLAMA_URL=http://127.0.0.1:11434
COMMONLINE_AGENT_TIMEOUT_MS=45000
COMMONLINE_AGENT_NUM_CTX=4096
