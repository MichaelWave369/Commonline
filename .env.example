# Browser client WebSocket endpoint.
# localhost may use ws:// for development. Deployed Commonline must use wss://.
VITE_COMMONLINE_WS_URL=ws://localhost:8787

# Server-provided ICE discovery.
# Comma-separate multiple URLs.
COMMONLINE_STUN_URLS=

# TURN relay URLs. Comma-separate UDP/TCP/TLS variants as needed.
COMMONLINE_TURN_URLS=

# Preferred for coturn REST-style time-limited credentials.
# Keep this secret on the Commonline server only.
COMMONLINE_TURN_SHARED_SECRET=
COMMONLINE_TURN_CREDENTIAL_TTL_SECONDS=3600

# Demo/local fallback only. Long-lived static TURN credentials are not
# recommended for public deployments.
COMMONLINE_TURN_USERNAME=
COMMONLINE_TURN_CREDENTIAL=

# "all" allows direct/STUN paths and TURN fallback.
# "relay" forces TURN and is useful for relay verification.
COMMONLINE_ICE_TRANSPORT_POLICY=all

# Room service HTTP/WebSocket port.
PORT=8787

# Local durable Commonline room database.
COMMONLINE_DB_PATH=./data/commonline.db
