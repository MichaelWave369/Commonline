{
  "name": "commonline",
  "private": true,
  "version": "0.0.1",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -n server,web \"npm run dev -w @commonline/server\" \"npm run dev -w @commonline/web\"",
    "dev:server": "npm run dev -w @commonline/server",
    "dev:web": "npm run dev -w @commonline/web",
    "build": "npm run build -ws --if-present",
    "typecheck": "npm run typecheck -ws --if-present",
    "test": "npm run test -ws --if-present && node --test tests/p0x-pilot.test.mjs tests/p0y-qualify.test.mjs tests/p0z-prepare.test.mjs tests/p0aa-host.test.mjs",
    "test:media-acceptance": "playwright test tests/e2e/media-acceptance.spec.ts --project=chromium",
    "test:p0-experience": "playwright test tests/e2e/experience-proof.spec.ts --project=chromium",
    "test:p0-governance": "playwright test tests/e2e/governance-probes.spec.ts --project=chromium",
    "pilot:p0:validate-registration": "node scripts/p0x-pilot.mjs validate-registration",
    "pilot:p0:validate-result": "node scripts/p0x-pilot.mjs validate-result",
    "pilot:p0:summarize": "node scripts/p0x-pilot.mjs summarize",
    "pilot:p0:qualify-worker": "node scripts/p0y-qualify.mjs qualify",
    "pilot:p0:finalize-registration": "node scripts/p0y-qualify.mjs finalize",
    "pilot:p0:prepare-execution": "node scripts/p0z-prepare.mjs prepare",
    "pilot:p0:create-cert": "powershell -ExecutionPolicy Bypass -File scripts/p0aa-create-cert.ps1",
    "pilot:p0:host": "node scripts/p0aa-host.mjs"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "vitest": "^3.2.4",
    "@playwright/test": "^1.55.0"
  }
}
